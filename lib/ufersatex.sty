%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%          Apendices e Anexos         %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Pelo template da UFERSA, os apendices e anexos aparecem no texto como
% "APÊNDICE A – TÍTULO" (centralizado) e "ANEXO A – TÍTULO" (alinhado a
% esquerda), em negrito e maiusculas, e no sumario alinhados aos demais
% titulos, sem uma folha separadora "APÊNDICES"/"ANEXOS".
\newcommand{\apendice}[1]{\chapter{#1}}
\newcommand{\anexo}[1]{\chapter{#1}}

\provideboolean{ufersa@anexos}
\setboolean{ufersa@anexos}{false}

\newcommand{\imprimirapendices}{\apendices}
\newcommand{\imprimiranexos}{\anexos\setboolean{ufersa@anexos}{true}}

% Titulo da secao primaria: igual ao do abnTeX2, exceto pelo alinhamento
% dos anexos a esquerda.
\def\printchaptertitle#1{%
	\chaptitlefont%
	\ifthenelse{\boolean{abntex@innonumchapter}}{\centering\ABNTEXchapterupperifneeded{#1}}{%
	\ifthenelse{\boolean{abntex@apendiceousecao}}{%
		\ifthenelse{\boolean{ufersa@anexos}}{\raggedright}{\centering}%
		\settowidth{\chapternamenumlength}{\printchaptername\printchapternum\afterchapternum}%
		\ABNTEXchapterupperifneeded{#1}%
	}{%
		\settowidth{\chapternamenumlength}{\printchaptername\printchapternum\afterchapternum}%
		\parbox[t]{\columnwidth-\chapternamenumlength}{\ABNTEXchapterupperifneeded{#1}}}%
	}%
}

% Numero da secao primaria com um unico espaco antes do titulo
% ("1 INTRODUÇÃO" e "APÊNDICE A – TÍTULO"); a definicao original do
% abnTeX2 insere espacos duplicados.
\renewcommand{\printchapternum}{%
	\tocprintchapter
	\setboolean{abntex@innonumchapter}{false}%
	\chapnumfont
	\ifthenelse{\boolean{abntex@apendiceousecao}}{%
		\tocinnonumchapter\thechapter\unskip~\textendash~\ignorespaces
	}{%
		\thechapter\space
	}%
}

