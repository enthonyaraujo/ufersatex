\renewcommand{\imprimircapa}{%
	% A capa nao e contada na paginacao (template UFERSA): recebe o rotulo
	% "capa" e a folha de rosto passa a ser a pagina 1.
	\begingroup
	\renewcommand{\thepage}{capa}%
	\hypersetup{pageanchor=false}%
	\begin{capa}%
		\center
		\includegraphics[width=4.2cm]{lib/logo-ufersa}\par
		\vspace{0.3cm}
		\MakeUppercase{\imprimiries}\par
		\abntex@ifnotempty{\imprimirproreitoria}{\MakeUppercase{\imprimirproreitoria}\par}
		\abntex@ifnotempty{\imprimirdepartamento}{\MakeUppercase{\imprimirdepartamento}\par}
		\abntex@ifnotempty{\imprimirprograma}{\MakeUppercase{\imprimirprograma}\par}
		\abntex@ifnotempty{\imprimircurso}{\MakeUppercase{\imprimircurso}\par}

		\vfill
		\ufersa@caixa{\imprimirautor}\par
		\vfill
		\imprimirtitulocompleto\par
		\vfill
		\vfill
		\MakeUppercase{\imprimirlocal}\par
		\imprimirdata
	\end{capa}%
	\endgroup
	\hypersetup{pageanchor=true}%
	\setcounter{page}{1}%
}

