% Determina o tipo do trabalho apresentado
% Valores aceitos em \trabalhoacademico{}:
%   tccgraduacao      - Monografia (graduacao)
%   memorial          - Memorial (graduacao)
%   tccespecializacao - Trabalho de Conclusao de Curso (especializacao)
%   dissertacao       - Dissertacao (mestrado)
%   tese              - Tese (doutorado)

\provideboolean{ufersa@ehgraduacao}
\setboolean{ufersa@ehgraduacao}{true}

\newcommand{\ufersa@tipodetrabalho}{Monografia}
\newcommand{\ufersa@apresentad}{apresentada}

\newcommand{\trabalhoacademico}[1]{%
	\setboolean{ufersa@ehgraduacao}{false}%
	\ifthenelse{\equal{#1}{tccgraduacao}}{%
		\setboolean{ufersa@ehgraduacao}{true}%
		\renewcommand{\ufersa@tipodetrabalho}{Monografia}%
		\renewcommand{\ufersa@apresentad}{apresentada}%
	}{}%
	\ifthenelse{\equal{#1}{memorial}}{%
		\setboolean{ufersa@ehgraduacao}{true}%
		\renewcommand{\ufersa@tipodetrabalho}{Memorial}%
		\renewcommand{\ufersa@apresentad}{apresentado}%
	}{}%
	\ifthenelse{\equal{#1}{tccespecializacao}}{%
		\renewcommand{\ufersa@tipodetrabalho}{Trabalho de Conclusão de Curso}%
		\renewcommand{\ufersa@apresentad}{apresentado}%
	}{}%
	\ifthenelse{\equal{#1}{dissertacao}}{%
		\renewcommand{\ufersa@tipodetrabalho}{Dissertação}%
		\renewcommand{\ufersa@apresentad}{apresentada}%
	}{}%
	\ifthenelse{\equal{#1}{tese}}{%
		\renewcommand{\ufersa@tipodetrabalho}{Tese}%
		\renewcommand{\ufersa@apresentad}{apresentada}%
	}{}%
	\tipotrabalho{\ufersa@tipodetrabalho}%
}

% Na graduacao, autor e titulo vao em maiusculas na capa, na folha de
% rosto e na folha de aprovacao; na pos-graduacao, sao grafados como digitados.
\newcommand{\ufersa@caixa}[1]{%
	\ifthenelse{\boolean{ufersa@ehgraduacao}}{\MakeUppercase{#1}}{#1}%
}

