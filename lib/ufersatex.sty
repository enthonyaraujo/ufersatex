% Espaçamento 1,5 entre linhas (NBR 14724, 5.2)
\renewcommand{\baselinestretch}{1.5}

% Margens: superior e esquerda 3 cm; inferior e direita 2 cm (NBR 14724, 5.1)
\setlrmarginsandblock{3cm}{2cm}{*} % esquerda / direita
\setulmarginsandblock{3cm}{2cm}{*} % superior / inferior

% Espacamentos nos titulos:
% chapter
\setlength{\beforechapskip}{-\onelineskip}
\setlength{\afterchapskip}{\onelineskip}

% section
\setbeforesecskip{18pt}
\setaftersecskip{\onelineskip}

% subsection
\setbeforesubsecskip{\onelineskip}
\setaftersubsecskip{\onelineskip}

% subsubsection
\setbeforesubsubsecskip{\onelineskip}
\setaftersubsubsecskip{\onelineskip}

% subsubsubsection
\setbeforeparaskip{\onelineskip}
\setafterparaskip{\onelineskip}

% Recuo da primeira linha do paragrafo: 1,25 cm (template UFERSA)
\setlength{\parindent}{1.25cm}

% Titulos das secoes (template UFERSA / manual institucional):
% - primarias: negrito e maiusculas;
% - secundarias: negrito, maiusculas/minusculas conforme a gramatica;
% - terciarias a quinarias: sem negrito.

% Secao primaria (1)
\renewcommand{\ABNTEXchapterfont}{\bfseries}
\renewcommand{\ABNTEXchapterfontsize}{\normalsize}

% Secao secundaria (1.1)
\renewcommand{\ABNTEXsectionfont}{\bfseries\normalsize}
\renewcommand{\ABNTEXsectionfontsize}{\normalsize}

% Secao terciaria (1.1.1)
\renewcommand{\ABNTEXsubsectionfont}{\normalfont}
\renewcommand{\ABNTEXsubsectionfontsize}{\normalsize}

% Secao quaternaria (1.1.1.1)
\renewcommand{\ABNTEXsubsubsectionfont}{\normalfont}
\renewcommand{\ABNTEXsubsubsectionfontsize}{\normalsize}

% Secao quinaria (1.1.1.1.1)
\renewcommand{\ABNTEXsubsubsubsectionfont}{\normalfont}
\renewcommand{\ABNTEXsubsubsubsectionfontsize}{\normalsize}

% Remove o ponto final de cada entrada da
% lista de abreviaturas e siglas
\renewcommand{\glspostdescription}{}

