% Por algum motivo, o algorithm2e estava pegando algumas palavras do espanhol.
% Acredito que seja porque os comandos \para seja idêntico nos dois idiomas.
% Esses comando resolvem o problema
\SetKwFor{Para}{para}{faça}{fim para}
\SetKwBlock{Inicio}{início}{fim}

% Espaco entre as linhas do algoritmo
\newcommand{\SetSpacedAlgorithm}{
	\linespread{1.35}\selectfont
}

% Altera o titulo para esse
\renewcommand{\listalgorithmcfname}{Lista de algoritmos}%

% Distance between floats on the top or the bottom and the text;
\setlength{\textfloatsep}{18pt plus 2pt minus 2pt}

% Distance between floats inserted inside the page text (using h) and the text proper.
\setlength{\intextsep}{18pt plus 2pt minus 2pt}

% Titulos das ilustracoes e tabelas: tamanho 12, espaco simples, centralizados
% quando ocupam uma linha e justificados (com recuo) quando ocupam mais linhas.
\captionsetup{font=singlespacing,format=hang,justification=justified,singlelinecheck=true,skip=2pt}

% Conteudo de quadros e tabelas em tamanho 12, como no template UFERSA
% (o abnTeX2 usa fonte reduzida por padrao).
\renewcommand{\IBGEtabfontsize}{\normalsize}

\AtBeginDocument{%
	% Aplica a mesma regra aos titulos montados com \IBGEtab
	\renewcommand{\configurecaptions}{%
		\captionsetup{format=hang,justification=justified,singlelinecheck=true}%
	}%
}

% Fonte e nota das ilustracoes e tabelas: fonte menor, espaco simples,
% alinhadas a esquerda. Uso: \Fonte{Elaborada pelo autor (2026).}
\newcommand{\Fonte}[2][\fontename]{%
	\vspace{2pt}%
	\begingroup
		\captionsetup{singlelinecheck=false,justification=raggedright}%
		\begin{SingleSpace}%
			\fonte[#1]{#2}%
		\end{SingleSpace}%
	\endgroup
}

% Cria o comando para fazer notas e anotacoes na figura e na tabela
\newcommand{\Nota}[2][\notaname]{\Fonte[#1]{#2}}


%Remove as bordas do hyperlinks.
\newcommand{\removerbordasdohyperlink}[1]{%
