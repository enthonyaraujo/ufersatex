% Texto de apresentacao (natureza) usado na folha de rosto e na folha de
% aprovacao, conforme os templates da UFERSA:
%  - graduacao: "Monografia apresentada à UFERSA como requisito para
%    obtenção do título de Bacharel em XYZ."
%  - pos-graduacao: "Tese apresentada ao Doutorado em XYZ do Programa de
%    Pós-Graduação em XYZ da UFERSA como requisito para obtenção do
%    título de Doutor em XYZ."
\preambulo{%
	\ifthenelse{\boolean{ufersa@ehgraduacao}}{%
		\imprimirtipotrabalho\ \ufersa@apresentad\ à \imprimiries\ como requisito
		para obtenção do título de \imprimirtituloobtido.%
	}{%
		\imprimirtipotrabalho\ \ufersa@apresentad\ ao \imprimircurso%
		\abntex@ifnotempty{\imprimirprograma}{\ do \imprimirprograma}\ da
		\imprimiries\ como requisito para obtenção do título de
		\imprimirtituloobtido.%
		\abntex@ifnotempty{\imprimirlinhadepesquisa}{\par\vspace{\onelineskip}%
			Linha de Pesquisa: \imprimirlinhadepesquisa}%
	}%
}

% Titulo em negrito; subtitulo (opcional) sem negrito.
\newcommand{\imprimirtitulocompleto}{%
	{\bfseries\ufersa@caixa{\imprimirtitulo}\abntex@ifnotempty{\imprimirsubtitulo}{:}}%
	\abntex@ifnotempty{\imprimirsubtitulo}{ \ufersa@caixa{\imprimirsubtitulo}}%
}

