% Define o comprimento da linha das assinaturas na Folha de Aprovacao
\setlength{\ABNTEXsignwidth}{9cm}

% Largura da linha da assinatura
\setlength{\ABNTEXsignthickness}{0.5pt}

% Espaço entre uma assintura e outra
\setlength{\ABNTEXsignskip}{\onelineskip}

% Imprime um membro da banca: "Nome, Prof. Dr. (SIGLA)" e a funcao.
\newcommand{\ufersa@membrodabanca}[3]{%
	\abntex@ifnotempty{#1}{%
		\assinatura{#1\abntex@ifnotempty{#2}{ (#2)}\\ #3}%
	}%
}

% Folha de aprovacao gerada pelo LaTeX, conforme o template da UFERSA.
% O orientador preside a banca; o coorientador (se houver) vem em seguida;
% os demais membros sao "Membro Examinador".
\newcommand{\imprimirfolhadeaprovacao}{%
	\begin{folhadeaprovacao}
		\begin{center}
			\ufersa@caixa{\imprimirautor}\par
			\vspace*{2\onelineskip}
			\imprimirtitulocompleto\par
		\end{center}

		\vspace*{2\onelineskip}

		\ufersa@blocodanatureza{\imprimirpreambulo}

		\vspace*{2\onelineskip}

		\noindent Defendida em: \ifthenelse{\equal{\imprimirdataaprovacao}{}}%
			{\rule{1.2cm}{0.4pt} / \rule{1.2cm}{0.4pt} / \rule{2cm}{0.4pt}}%
			{\imprimirdataaprovacao}.

		\vspace*{2\onelineskip}

		\begin{center}
			\textbf{BANCA EXAMINADORA}
		\end{center}

		\begin{SingleSpace}
		\ufersa@membrodabanca{\imprimirorientador}{\imprimirorientadories}{Presidente}
		\ufersa@membrodabanca{\imprimircoorientador}{\imprimircoorientadories}{\artigocoorientador}
		\ufersa@membrodabanca{\imprimirmembrodabancadois}{\imprimirmembrodabancadoisies}{Membro Examinador}
		\ufersa@membrodabanca{\imprimirmembrodabancatres}{\imprimirmembrodabancatresies}{Membro Examinador}
		\ufersa@membrodabanca{\imprimirmembrodabancaquatro}{\imprimirmembrodabancaquatroies}{Membro Examinador}
		\ufersa@membrodabanca{\imprimirmembrodabancacinco}{\imprimirmembrodabancacincoies}{Membro Examinador}
		\ufersa@membrodabanca{\imprimirmembrodabancaseis}{\imprimirmembrodabancaseisies}{Membro Examinador}
		\end{SingleSpace}
	\end{folhadeaprovacao}
}

% Insere a folha de aprovacao ja assinada (PDF digitalizado), quando o
% curso/programa exigir a versao assinada na versao final.
\newcommand{\imprimirfolhadeaprovacaoassinada}[1]{%
	\includepdf[pages=-,pagecommand={\thispagestyle{empty}}]{#1}%
}

