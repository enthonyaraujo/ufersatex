% Bloco da natureza do trabalho: recuo de 8 cm, espaco simples, justificado
\newcommand{\ufersa@blocodanatureza}[1]{%
	\noindent\hspace*{8cm}%
	\begin{minipage}{\dimexpr\textwidth-8cm\relax}
		\SingleSpacing
		#1
	\end{minipage}\par
}

\renewcommand{\folhaderostocontent}{
	\begin{center}
		\ufersa@caixa{\imprimirautor}\par
		\vspace*{4cm}
		\imprimirtitulocompleto\par
	\end{center}

	\vspace*{3cm}

	\ufersa@blocodanatureza{%
		\imprimirpreambulo\par
		\vspace{\onelineskip}
		\artigoorientador: \imprimirorientador\par
		\abntex@ifnotempty{\imprimircoorientador}{%
			\vspace{\onelineskip}
			\artigocoorientador: \imprimircoorientador\par
		}%
	}

	\vfill
	\begin{center}
		\MakeUppercase{\imprimirlocal}\par
		\imprimirdata
	\end{center}
}

